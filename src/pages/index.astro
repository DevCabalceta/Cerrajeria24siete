---
import FloatingActions from '../components/layout/FloatingActions.astro';
import Footer from '../components/layout/Footer.astro';
import Header from '../components/layout/Header.astro';
import { business } from '../data/business';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../sections/Hero.astro';
import Introduction from '../sections/Introduction.astro';
import Automotive from '../sections/Automotive.astro';
import Coverage from '../sections/Coverage.astro';
import Emergency from '../sections/Emergency.astro';
import Faq from '../sections/Faq.astro';
import FinalCta from '../sections/FinalCta.astro';
import Gallery from '../sections/Gallery.astro';
import Gates from '../sections/Gates.astro';
import Residential from '../sections/Residential.astro';
import Services from '../sections/Services.astro';
import WhyUs from '../sections/WhyUs.astro';

// Search-first title (what people type: "cerrajero 24 horas") and a ~155-character
// description, the length Google and WhatsApp show before truncating.
const title = `Cerrajero 24 horas en ${business.country} | ${business.name}`;
const description = `Cerrajero a domicilio 24 horas en ${business.coverage.areas.slice(0, -1).join(', ')} y ${business.coverage.areas.at(-1)}: apertura de casas y carros, llaves con chip, cajas fuertes y portones. Llame al ${business.phone.short}.`;
---

<BaseLayout title={title} description={description}>
  <Header />

  <main id="main" data-menu-inert>
    <Hero />
    <Introduction />
    <Services />
    <Emergency />
    <Automotive />
    <Residential />
    <Gates />
    <WhyUs />
    <Coverage />
    <Gallery />
    <Faq />
    <FinalCta />
  </main>

  <Footer />
  <FloatingActions />
</BaseLayout>
