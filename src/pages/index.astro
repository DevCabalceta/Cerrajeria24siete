---
import HeroSection from '../components/sections/HeroSection.astro';
import ServicesSection from '../components/sections/ServicesSection.astro';
import CoverageSection from '../components/sections/CoverageSection.astro';
import SiteHeader from '../components/navigation/SiteHeader.astro';
import heroImage from '../assets/images/hero/key-cutting-workshop.png';
import { getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';

const optimizedSocialImage = await getImage({
	src: heroImage,
	width: 1200,
	height: 630,
	format: 'jpg',
	quality: 80,
});
const socialImage = new URL(optimizedSocialImage.src, Astro.site).toString();
---

<Layout image={socialImage}>
	<SiteHeader />
	<main id="contenido">
		<HeroSection />
		<ServicesSection />
		<CoverageSection />
	</main>
</Layout>

<script>
	import { initSectionTransitions } from '../scripts/section-transitions';
	initSectionTransitions();
</script>
