---
import GateStage from '../components/interactive/GateStage';
import { ArrowUpRightIcon } from '../components/ui/icons';
import { gateServices, motors } from '../data/gates';
import { whatsappHref } from '../utils/contact';
---

<section id="portones" aria-labelledby="portones-title" class="relative bg-ink py-24 text-paper sm:py-28 lg:py-36">
  <div class="container-x">
    <header class="grid gap-y-6 lg:grid-cols-12 lg:items-end lg:gap-x-10">
      <div class="lg:col-span-7">
        <p class="flex items-center gap-3 font-mono text-label text-paper/60 uppercase">
          <span class="text-paper">(06)</span>
          Portones eléctricos
        </p>
        <h2
          id="portones-title"
          class="mt-5 text-[clamp(2.25rem,4.5vw+0.75rem,4.5rem)] leading-[0.98] font-medium tracking-[-0.045em] text-balance"
        >
          Su portón, abriendo como el primer día.
        </h2>
      </div>
      <p class="max-w-[30rem] text-pretty text-paper/70 lg:col-span-5 lg:justify-self-end lg:pb-2 lg:text-[1.0625rem]">
        Restauración, reparación y mantenimiento de portones y motores eléctricos para hogares y empresas. Pruebe el
        control y cambie el tipo de motor.
      </p>
    </header>

    <div class="mt-14 lg:mt-20">
      <GateStage client:visible motors={motors} />
    </div>

    <ul class="mt-16 grid border-t border-paper/15 sm:grid-cols-2 lg:mt-20 lg:grid-cols-4">
      {
        gateServices.map((service, i) => (
          <li
            class:list={[
              'border-b border-paper/15 lg:border-b-0',
              i % 2 === 1 && 'sm:border-l sm:border-paper/15',
              i > 0 && 'lg:border-l lg:border-paper/15',
            ]}
          >
            <a
              href={whatsappHref(`Hola, necesito: ${service.message}.`)}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Consultar por WhatsApp: ${service.title}`}
              class="group/svc flex h-full flex-col gap-3 py-6 transition-colors duration-300 ease-premium hover:bg-paper/[0.04] sm:px-6 lg:py-8"
            >
              <span class="flex items-center justify-between font-mono text-label text-paper/60">
                {String(i + 1).padStart(2, '0')}
                <ArrowUpRightIcon className="size-3.5 transition-[rotate,color] duration-500 ease-spring group-hover/svc:rotate-45 group-hover/svc:text-paper" />
              </span>
              <span class="text-lg font-medium tracking-[-0.015em]">{service.title}</span>
              <span class="text-sm text-pretty text-paper/70">{service.text}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
