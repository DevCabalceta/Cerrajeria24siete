---
import KeyStage from '../components/interactive/KeyStage';
import Button from '../components/ui/Button';
import { ArrowUpRightIcon } from '../components/ui/icons';
import { business } from '../data/business';
import { telHref, whatsappHref } from '../utils/contact';

// Headline lines are set explicitly: the break after "confianza," is compositional.
const headline = [
  { text: 'Su cerrajería', tone: 'ink' },
  { text: 'de confianza,', tone: 'ink' },
  { text: '24 horas,', tone: 'muted' },
  { text: '7 días.', tone: 'muted' },
] as const;

// Only facts stated on the current site. `short` is used on phones (3-column strip).
const facts = [
  { label: 'Horario', value: '24 h · 365 días', short: '24 h · 365 días' },
  { label: 'Experiencia', value: business.experienceShort, short: business.experienceShort },
  { label: 'Cobertura', value: 'GAM y todo el país', short: 'Todo el país' },
  { label: 'Servicio', value: 'A domicilio', short: null },
];
---

<section id="inicio" aria-labelledby="hero-title" class="relative flex min-h-svh flex-col pt-16 lg:pt-20">
  <div class="container-x flex flex-1 flex-col">
    <div
      class="grid flex-1 grid-rows-[auto_1fr] gap-y-5 py-[clamp(1rem,3svh,3rem)] lg:grid-cols-12 lg:grid-rows-1 lg:gap-x-10"
    >
      <!-- Copy -->
      <div class="flex flex-col items-start justify-center lg:col-span-7">
        <a
          href="#emergencias"
          class="group/badge inline-flex h-9 animate-fade-up items-center gap-2.5 rounded-full bg-ink/[0.045] pr-1.5 pl-3.5 text-[0.8125rem] tracking-[-0.01em] whitespace-nowrap text-muted transition-colors duration-300 ease-premium hover:bg-ink/[0.075]"
        >
          <span class="relative grid size-2 place-items-center" aria-hidden="true">
            <span class="absolute inset-0 rounded-full bg-live motion-safe:animate-live-ping"></span>
            <span class="relative size-1.5 rounded-full bg-live"></span>
          </span>
          <span class="font-medium text-ink">Disponible ahora</span>
          <span aria-hidden="true" class="hidden text-ink/25 min-[22.5rem]:inline">·</span>
          <span class="hidden min-[22.5rem]:inline">Emergencias 24/7</span>
          <span
            aria-hidden="true"
            class="ml-0.5 grid size-6 place-items-center rounded-full bg-paper text-ink transition-transform duration-500 ease-spring group-hover/badge:rotate-45"
          >
            <ArrowUpRightIcon className="size-3" />
          </span>
        </a>

        <!-- Size is bound to both width and height so the whole hero fits one screen. -->
        <h1
          id="hero-title"
          class="mt-[clamp(1rem,3svh,2rem)] text-[clamp(2.5rem,min(12.5vw,6.2svh),3.25rem)] leading-[0.95] font-medium tracking-[-0.045em] sm:text-hero"
        >
          {
            headline.map((line, i) => (
              <span class:list={['block pb-[0.06em]', line.tone === 'muted' && 'text-muted']}>
                <span class="block animate-rise" style={`animation-delay: ${40 + i * 70}ms`}>
                  {line.text}{' '}
                </span>
              </span>
            ))
          }
        </h1>

        <p
          class="mt-[clamp(0.875rem,2.75svh,2rem)] max-w-[44rem] animate-fade-up text-base leading-relaxed text-pretty text-muted sm:text-[1.0625rem] lg:text-lg"
          style="animation-delay: 380ms"
        >
          <!-- On phones the strip below already states coverage; keep the copy to two lines. -->
          Cerrajería en general y portones eléctricos a domicilio, todo el año.{' '}
          <span class="hidden sm:inline">
            Atendemos emergencias en {business.coverage.areas.join(', ')} y todo el territorio nacional.
          </span>
        </p>

        <div class="mt-[clamp(1rem,3svh,2rem)] w-full animate-fade-up sm:w-auto" style="animation-delay: 480ms">
          <div class="grid grid-cols-1 gap-3 min-[22.5rem]:grid-cols-2 sm:flex">
            <Button href={telHref} size="hero" icon="phone" className="w-full sm:w-auto">Llamar ahora</Button>
            <Button href={whatsappHref()} size="hero" variant="quiet" icon="whatsapp" arrow external className="w-full sm:w-auto">
              WhatsApp
            </Button>
          </div>
          <p class="mt-4 hidden font-mono text-label text-muted uppercase sm:block xl:hidden">
            Línea directa ·{' '}
            <a href={telHref} class="link-underline pb-0.5 text-ink tabular-nums">{business.phone.display}</a>
          </p>
        </div>
      </div>

      <!-- Interactive keyring -->
      <div class="relative min-h-[11rem] animate-fade-up sm:min-h-[15rem] lg:col-span-5 lg:min-h-0" style="animation-delay: 260ms">
        <div class="absolute inset-0">
          <KeyStage client:idle />
        </div>
      </div>
    </div>

    <!-- Facts strip, pinned to the bottom of the first screen -->
    <dl class="relative grid grid-cols-3 pb-[env(safe-area-inset-bottom)] sm:grid-cols-4">
      <span
        aria-hidden="true"
        class="absolute inset-x-0 top-0 h-px origin-left animate-draw-x bg-line"
        style="animation-delay: 600ms"
      ></span>
      {
        facts.map((fact, i) => (
          <div
            class:list={[
              'animate-fade-up py-3 pr-2 sm:py-4 sm:pr-4',
              i > 0 && 'border-l border-line pl-3 sm:pl-5 lg:pl-6',
              !fact.short && 'hidden sm:block',
            ]}
            style={`animation-delay: ${680 + i * 70}ms`}
          >
            <dt class="font-mono text-label text-muted uppercase">{fact.label}</dt>
            <dd class="mt-1 text-[0.8125rem] tracking-[-0.01em] text-ink sm:mt-1.5 sm:text-[0.9375rem]">
              {fact.short && fact.short !== fact.value ? (
                <>
                  <span class="sm:hidden">{fact.short}</span>
                  <span class="hidden sm:inline">{fact.value}</span>
                </>
              ) : (
                fact.value
              )}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
