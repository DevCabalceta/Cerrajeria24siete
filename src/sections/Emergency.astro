---
import EmergencyClock from '../components/interactive/EmergencyClock';
import EmergencyPicker from '../components/interactive/EmergencyPicker';
import { business } from '../data/business';
import { emergencies } from '../data/emergencies';
import { telHref } from '../utils/contact';

// All three steps restate facts from the current site (24/7, coverage, home
// service, "Entregamos informe del servicio realizado").
const steps = [
  { title: 'Llame o escriba', detail: `${business.availability.long}.` },
  { title: 'Indique su ubicación', detail: `${business.coverage.areas.join(', ')} y todo el país.` },
  { title: 'Lo atendemos a domicilio', detail: 'Y le entregamos un informe del servicio realizado.' },
];
---

<section id="emergencias" aria-labelledby="emergencias-title" class="relative overflow-hidden bg-cobalt py-24 text-paper sm:py-28 lg:py-32">
  <div class="container-x">
    <div class="grid items-center gap-y-14 lg:grid-cols-12 lg:gap-x-12">
      <!-- Copy + triage -->
      <div class="lg:order-2 lg:col-span-7">
        <p class="flex items-center gap-3 font-mono text-label text-paper/80 uppercase">
          <span class="text-paper">(03)</span>
          Emergencias 24/7
        </p>
        <h2
          id="emergencias-title"
          class="mt-5 text-[clamp(2.25rem,4.4vw+0.75rem,4.5rem)] leading-[0.98] font-medium tracking-[-0.045em] text-balance"
        >
          ¿Se quedó afuera? Llame ahora, a cualquier hora.
        </h2>
        <p class="mt-6 max-w-[36rem] text-pretty text-paper/80 lg:text-[1.0625rem]">
          Atendemos emergencias de cerrajería y portones eléctricos a domicilio, en{' '}
          {business.coverage.areas.join(', ')} y todo el territorio nacional. Cotice sin ningún compromiso.
        </p>

        <div class="mt-10">
          <EmergencyPicker
            client:visible
            emergencies={emergencies.map(({ id, label, glyph, message }) => ({ id, label, glyph, message }))}
            phone={{ href: telHref, display: business.phone.display }}
            whatsappNumber={business.whatsapp.number}
          />
        </div>
      </div>

      <!-- Live 24h clock -->
      <div class="lg:order-1 lg:col-span-5">
        <EmergencyClock client:visible />
        <p class="mt-6 text-center font-mono text-label text-paper/80 uppercase">24 de 24 horas disponibles · 365 días</p>
      </div>
    </div>

    <!-- How it works -->
    <ol class="mt-20 grid border-t border-paper/20 sm:grid-cols-3 lg:mt-24">
      {
        steps.map((step, i) => (
          <li class:list={['py-6 sm:pr-6', i > 0 && 'border-t border-paper/20 sm:border-t-0 sm:border-l sm:pl-6']}>
            <span class="font-mono text-label text-paper/80">{String(i + 1).padStart(2, '0')}</span>
            <p class="mt-3 text-lg font-medium tracking-[-0.015em]">{step.title}</p>
            <p class="mt-1.5 text-sm text-pretty text-paper/80">{step.detail}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
