---
import KeyPlan from '../components/interactive/KeyPlan';
import { business } from '../data/business';
import { residentialExtras, residentialModes } from '../data/residential';
import { telHref, whatsappHref } from '../utils/contact';

const modes = residentialModes.map((mode) => ({ ...mode, href: whatsappHref(`Hola, necesito: ${mode.service}.`) }));
---

<section id="residencial" aria-labelledby="residencial-title" class="relative border-t border-line py-24 sm:py-28 lg:py-36">
  <div class="container-x">
    <header class="grid gap-y-6 lg:grid-cols-12 lg:items-end lg:gap-x-10">
      <div class="lg:col-span-7">
        <p class="flex items-center gap-3 font-mono text-label text-muted uppercase">
          <span class="text-ink">(05)</span>
          Residencial y comercial
        </p>
        <h2
          id="residencial-title"
          class="mt-5 text-[clamp(2.25rem,4.5vw+0.75rem,4.5rem)] leading-[0.98] font-medium tracking-[-0.045em] text-balance"
        >
          Una llave para cada puerta. Una maestra para todas.
        </h2>
      </div>
      <p class="max-w-[30rem] text-pretty text-muted lg:col-span-5 lg:justify-self-end lg:pb-2 lg:text-[1.0625rem]">
        Casas, oficinas y locales. Elija una llave y vea en el plano qué puertas abre.
      </p>
    </header>

    <div class="mt-14 lg:mt-20">
      <KeyPlan client:visible modes={modes} extras={residentialExtras} phone={{ href: telHref, display: business.phone.display }} />
    </div>
  </div>
</section>
