---
import { business } from '../../data/business';
import { serviceCategories, services } from '../../data/services';

interface Props {
  title: string;
  description: string;
  /** Root-relative or absolute. Defaults to the generated preview (scripts/build-og-assets.mjs). */
  image?: string;
  imageAlt?: string;
}

const {
  title,
  description,
  image = '/og-image.jpg',
  imageAlt = `${business.name}: ${business.tagline.toLowerCase()}, 24 horas, 7 días. Llame al ${business.phone.display}.`,
} = Astro.props;

const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL(image, site).href;
const home = new URL('/', site).href;

/*
 * Structured data, one connected graph. Only facts verified on the current site
 * (see data/business.ts and data/services.ts): no street address, geo coordinates,
 * price range, ratings or founding date, because none of them are published there.
 */
const ids = { business: `${home}#negocio`, website: `${home}#sitio`, page: `${canonical}#pagina` };
const hours = {
  '@type': 'OpeningHoursSpecification',
  dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
  opens: '00:00',
  closes: '23:59',
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Locksmith',
      '@id': ids.business,
      name: business.name,
      slogan: business.tagline,
      description,
      url: home,
      logo: { '@type': 'ImageObject', url: new URL('/icon-512.png', site).href, width: 512, height: 512 },
      image: ogImage,
      telephone: business.phone.e164,
      email: business.email,
      address: { '@type': 'PostalAddress', addressCountry: business.countryCode },
      areaServed: [
        ...business.coverage.areas.map((name) => ({ '@type': 'AdministrativeArea', name })),
        { '@type': 'Country', name: business.country },
      ],
      openingHoursSpecification: hours,
      contactPoint: {
        '@type': 'ContactPoint',
        telephone: business.phone.e164,
        email: business.email,
        contactType: 'customer service',
        areaServed: business.countryCode,
        availableLanguage: 'es',
        hoursAvailable: hours,
      },
      knowsAbout: serviceCategories.map((category) => category.label),
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Servicios de cerrajería y portones eléctricos',
        itemListElement: serviceCategories.map((category) => ({
          '@type': 'OfferCatalog',
          name: category.label,
          itemListElement: services
            .filter((service) => service.category === category.id)
            .map((service) => ({
              '@type': 'Offer',
              itemOffered: { '@type': 'Service', name: service.title, description: service.summary },
            })),
        })),
      },
      ...(business.socials.length > 0 && { sameAs: business.socials.map((social) => social.href) }),
    },
    {
      '@type': 'WebSite',
      '@id': ids.website,
      url: home,
      name: business.name,
      inLanguage: 'es-CR',
      publisher: { '@id': ids.business },
    },
    {
      '@type': 'WebPage',
      '@id': ids.page,
      url: canonical,
      name: title,
      description,
      inLanguage: 'es-CR',
      isPartOf: { '@id': ids.website },
      about: { '@id': ids.business },
      primaryImageOfPage: { '@type': 'ImageObject', url: ogImage, width: 1200, height: 630 },
    },
  ],
};
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />

<!-- Link previews (WhatsApp, Facebook, LinkedIn, X…). Kept at the top of <head>:
     some crawlers, WhatsApp's included, only read the first part of the document. -->
<meta property="og:type" content="website" />
<meta property="og:locale" content="es_CR" />
<meta property="og:site_name" content={business.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:secure_url" content={ogImage} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={imageAlt} />

<!-- Local signals: only the country is published, so no city or coordinates. -->
<meta name="geo.region" content={business.countryCode} />
<meta name="geo.placename" content={business.country} />

<meta name="application-name" content={business.name} />
<meta name="apple-mobile-web-app-title" content={business.name} />
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />

<link rel="sitemap" href="/sitemap-index.xml" />
<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
