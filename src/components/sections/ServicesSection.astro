---
import { Image } from 'astro:assets';
import { SERVICES, SPECIALIZED_SERVICES } from '../../data/services';

const serviceWhatsappLink = (service: string) =>
	`https://wa.me/50683557575?text=${encodeURIComponent(`Hola Cerrajería24siete, necesito información sobre ${service}.`)}`;
---

<section
	class="services"
	id="servicios"
	aria-labelledby="services-title"
	data-section-panel
	data-services
>
	<div class="services-intro page-shell">
		<div class="services-key-mask" aria-hidden="true">
			<svg viewBox="0 0 1000 500">
				<path
					fill-rule="evenodd"
					d="M760 52a188 188 0 1 1 0 376 188 188 0 0 1 0-376Zm0 112a76 76 0 1 0 0 152 76 76 0 0 0 0-152Z"
				/>
				<path d="M78 204h548v72h-82v76h-88v-76h-66v54h-86v-54H78v-72Z" />
			</svg>
		</div>

		<div class="services-label" data-services-intro>
			<span>02</span>
			<p>Servicios</p>
		</div>

		<div class="services-heading">
			<h2 id="services-title" data-services-intro>
				<span class="heading-line">Todo acceso tiene</span>
				<span class="heading-line heading-accent">una solución.</span>
			</h2>
			<div class="services-intro-copy" data-services-intro>
				<p>
					Desde una emergencia cotidiana hasta un sistema de acceso especializado.
					Un mismo estándar profesional para proteger lo que importa.
				</p>
				<span class="availability"><i></i> Atención a domicilio · 24/7</span>
			</div>
		</div>
	</div>

	<div class="services-scroll" data-services-scroll>
		<div class="services-sticky" data-services-sticky>
			<div class="services-track" data-services-track>
				{SERVICES.map((service) => (
					<article
						class="service-card"
						style={`--card-accent: ${service.accent}`}
						data-service-card
					>
						<div class="service-media">
							<Image
								src={service.image}
								alt={service.imageAlt}
								widths={[500, 800, 1200]}
								sizes="(max-width: 900px) 100vw, 42vw"
								format="webp"
								quality={80}
								loading="lazy"
							/>
							<div class="media-shade" aria-hidden="true"></div>
							<span class="service-number">{service.number}</span>
							<span class="service-category">{service.category}</span>
						</div>

						<div class="service-body">
							<div>
								<p class="service-overline">Área de servicio</p>
								<h3>{service.title}</h3>
								<p class="service-description">{service.description}</p>
							</div>

							<div class="service-bottom">
								<ul aria-label={`Incluye ${service.title}`}>
									{service.features.map((feature) => <li>{feature}</li>)}
								</ul>
								<a href={serviceWhatsappLink(service.title)} target="_blank" rel="noreferrer">
									Consultar
									<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5" /></svg>
								</a>
							</div>
						</div>
					</article>
				))}
			</div>

			<div class="services-progress page-shell" aria-hidden="true">
				<span class="progress-label">Desliza para explorar</span>
				<div class="progress-line"><i data-services-progress></i></div>
				<span><b data-services-current>01</b> / {String(SERVICES.length).padStart(2, '0')}</span>
			</div>
		</div>
	</div>

	<div class="specialized page-shell" data-section-transition-surface>
		<div class="specialized-heading">
			<p>Servicios especializados</p>
			<h3>También resolvemos<br />los detalles.</h3>
		</div>
		<ol>
			{SPECIALIZED_SERVICES.map((service, index) => (
				<li data-specialized-item>
					<span>{String(index + 1).padStart(2, '0')}</span>
					<p>{service}</p>
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m7 17 10-10M8 7h9v9" /></svg>
				</li>
			))}
		</ol>
	</div>
</section>

<style>
	:global(html[data-motion='pending']) [data-services-intro] {
		opacity: 0;
		transform: translate3d(0, 45px, 0);
	}

	:global(html[data-motion='pending']) [data-specialized-item] {
		opacity: 0;
		transform: translate3d(0, 24px, 0);
	}

	.services {
		position: relative;
		overflow: clip;
		background: var(--color-section-light);
		color: #0a0d12;
	}

	.services-intro {
		position: relative;
		display: grid;
		min-height: min(48rem, 78svh);
		grid-template-columns: minmax(8rem, 0.2fr) 1fr;
		align-content: center;
		gap: 2rem;
		padding-top: clamp(6rem, 10vh, 9rem);
		padding-bottom: clamp(5rem, 9vh, 8rem);
	}

	.services-intro > :not(.services-key-mask) {
		position: relative;
		z-index: 1;
	}

	.services-key-mask {
		position: absolute;
		top: 8%;
		right: -4%;
		width: min(74vw, 68rem);
		color: #168bd2;
		opacity: 0.065;
		transform: rotate(-9deg);
		transform-origin: center;
		mask-image: linear-gradient(90deg, transparent 2%, black 34%, black 88%, transparent);
		pointer-events: none;
	}

	.services-key-mask svg {
		display: block;
		width: 100%;
		fill: currentColor;
	}

	.services-label {
		display: flex;
		align-items: flex-start;
		gap: 0.8rem;
		padding-top: 0.9rem;
		font-size: 0.7rem;
		font-weight: 750;
		letter-spacing: 0.13em;
		text-transform: uppercase;
	}

	.services-label span {
		display: grid;
		width: 2.1rem;
		aspect-ratio: 1;
		place-items: center;
		border: 1px solid rgba(10, 13, 18, 0.25);
		border-radius: 50%;
		color: #177dbd;
		font-size: 0.62rem;
	}

	.services-label p { margin: 0.55rem 0 0; }
	.services-heading {
		display: grid;
		grid-template-columns: minmax(38rem, 1fr) minmax(15rem, 18rem);
		align-items: end;
		gap: clamp(2rem, 3.5vw, 4rem);
	}

	.services-heading h2 {
		margin: 0;
		font-size: clamp(4.5rem, 6vw, 6.2rem);
		font-weight: 520;
		letter-spacing: -0.075em;
		line-height: 0.92;
	}

	.heading-line {
		display: block;
		white-space: nowrap;
	}

	.heading-accent { color: #168bd2; }
	.services-intro-copy {
		display: grid;
		gap: 2rem;
		padding-bottom: 0.55rem;
	}

	.services-intro-copy > p {
		margin: 0;
		color: rgba(10, 13, 18, 0.62);
		font-size: clamp(0.94rem, 1.25vw, 1.1rem);
		line-height: 1.75;
	}

	.availability {
		display: inline-flex;
		align-items: center;
		gap: 0.65rem;
		font-size: 0.67rem;
		font-weight: 750;
		letter-spacing: 0.09em;
		text-transform: uppercase;
	}

	.availability i {
		width: 0.42rem;
		aspect-ratio: 1;
		border-radius: 50%;
		background: #10a963;
		box-shadow: 0 0 0.8rem rgba(16, 169, 99, 0.5);
	}

	.services-scroll { position: relative; }
	.services-sticky {
		position: relative;
		display: flex;
		height: 100svh;
		min-height: 44rem;
		align-items: center;
		overflow: hidden;
		background: #dfe4e9;
	}

	.services-track {
		display: flex;
		width: max-content;
		gap: clamp(1rem, 2vw, 1.75rem);
		padding-inline: var(--page-gutter);
	}

	.service-card {
		display: grid;
		width: min(80vw, 74rem);
		height: min(69svh, 44rem);
		min-height: 34rem;
		flex: 0 0 auto;
		grid-template-columns: 51% 49%;
		overflow: hidden;
		border: 1px solid rgba(255, 255, 255, 0.09);
		border-radius: clamp(1.4rem, 2.4vw, 2.5rem);
		background: #0b0f15;
		box-shadow: 0 2rem 5rem rgba(26, 34, 44, 0.14);
		color: #f7f9fc;
	}

	.service-media {
		position: relative;
		min-width: 0;
		overflow: hidden;
		background: #161c24;
	}

	.service-media :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 900ms cubic-bezier(0.2, 0.75, 0.2, 1), filter 500ms ease;
	}

	.service-card:hover .service-media :global(img) { transform: scale(1.04); }
	.media-shade {
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, rgba(7, 9, 13, 0.08), rgba(7, 9, 13, 0.5));
	}

	.service-media::after {
		position: absolute;
		right: 0;
		bottom: 0;
		left: 0;
		height: 3px;
		background: var(--card-accent);
		content: '';
	}

	.service-number,
	.service-category {
		position: absolute;
		top: 1.6rem;
		font-size: 0.66rem;
		font-weight: 800;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.service-number { left: 1.6rem; color: var(--card-accent); }
	.service-category {
		right: 1.6rem;
		border: 1px solid rgba(255, 255, 255, 0.28);
		border-radius: 999px;
		background: rgba(7, 9, 13, 0.25);
		padding: 0.55rem 0.75rem;
		backdrop-filter: blur(10px);
	}

	.service-body {
		display: flex;
		min-width: 0;
		flex-direction: column;
		justify-content: space-between;
		gap: 2rem;
		padding: clamp(2rem, 4vw, 4.5rem);
	}

	.service-overline {
		margin: 0 0 clamp(1.5rem, 3vh, 2.5rem);
		color: var(--card-accent);
		font-size: 0.66rem;
		font-weight: 800;
		letter-spacing: 0.13em;
		text-transform: uppercase;
	}

	.service-body h3 {
		max-width: 8ch;
		margin: 0;
		font-size: clamp(2.8rem, 4.7vw, 5.6rem);
		font-weight: 520;
		letter-spacing: -0.065em;
		line-height: 0.94;
	}

	.service-description {
		max-width: 33rem;
		margin: clamp(1.4rem, 3vh, 2.2rem) 0 0;
		color: rgba(247, 249, 252, 0.62);
		font-size: clamp(0.88rem, 1.1vw, 1.02rem);
		line-height: 1.65;
	}

	.service-bottom {
		display: grid;
		grid-template-columns: 1fr auto;
		align-items: end;
		gap: 2rem;
	}

	.service-bottom ul { display: grid; gap: 0.55rem; margin: 0; padding: 0; list-style: none; }
	.service-bottom li {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		color: rgba(247, 249, 252, 0.52);
		font-size: 0.7rem;
	}

	.service-bottom li::before { width: 0.28rem; aspect-ratio: 1; border-radius: 50%; background: var(--card-accent); content: ''; }
	.service-bottom a {
		display: inline-flex;
		align-items: center;
		gap: 0.7rem;
		border-bottom: 1px solid rgba(255, 255, 255, 0.35);
		padding-bottom: 0.45rem;
		font-size: 0.7rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-decoration: none;
		text-transform: uppercase;
		transition: border-color 180ms ease, color 180ms ease;
	}

	.service-bottom a:hover { border-color: var(--card-accent); color: var(--card-accent); }
	.service-bottom svg { width: 1.05rem; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.6; }

	.services-progress {
		position: absolute;
		right: 0;
		bottom: 1.8rem;
		left: 0;
		display: grid;
		grid-template-columns: auto minmax(8rem, 1fr) auto;
		align-items: center;
		gap: 1rem;
		color: rgba(10, 13, 18, 0.5);
		font-size: 0.62rem;
		font-weight: 800;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.progress-line { height: 1px; overflow: hidden; background: rgba(10, 13, 18, 0.16); }
	.progress-line i { display: block; width: 100%; height: 100%; transform: scaleX(0); transform-origin: left; background: #168bd2; }
	.services-progress b { color: #0a0d12; font-weight: 800; }

	.specialized {
		display: grid;
		grid-template-columns: minmax(18rem, 0.75fr) 1fr;
		gap: clamp(3rem, 8vw, 9rem);
		padding-top: clamp(7rem, 12vw, 12rem);
		padding-bottom: clamp(7rem, 12vw, 12rem);
	}

	.specialized-heading > p {
		margin: 0 0 1.3rem;
		color: #168bd2;
		font-size: 0.68rem;
		font-weight: 800;
		letter-spacing: 0.13em;
		text-transform: uppercase;
	}

	.specialized-heading h3 {
		margin: 0;
		font-size: clamp(2.7rem, 4.5vw, 5rem);
		font-weight: 520;
		letter-spacing: -0.065em;
		line-height: 0.96;
	}

	.specialized ol { margin: 0; padding: 0; list-style: none; }
	.specialized li {
		display: grid;
		grid-template-columns: 2.25rem 1fr auto;
		align-items: center;
		gap: 0.75rem;
		border-top: 1px solid rgba(10, 13, 18, 0.16);
		padding-block: 1.25rem;
	}

	.specialized li:last-child { border-bottom: 1px solid rgba(10, 13, 18, 0.16); }
	.specialized li span { color: #168bd2; font-size: 0.62rem; font-weight: 800; letter-spacing: 0.08em; }
	.specialized li p { margin: 0; font-size: clamp(1rem, 1.45vw, 1.3rem); font-weight: 600; letter-spacing: -0.025em; }
	.specialized li svg { width: 1.1rem; fill: none; stroke: rgba(10, 13, 18, 0.42); stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.4; }

	.services.is-static .services-sticky { height: auto; min-height: 0; padding-block: 4rem; }
	.services.is-static .services-track { display: grid; width: 100%; }
	.services.is-static .service-card { width: 100%; }
	.services.is-static .services-progress { display: none; }

	@media (max-width: 75rem) {
		.services-heading { grid-template-columns: 1fr; align-items: start; }
		.services-intro-copy { max-width: 34rem; }
		.service-card { width: 86vw; }
	}

	@media (max-width: 56.25rem) {
		:global(html[data-motion='pending']) [data-service-card] {
			opacity: 0;
			transform: translate3d(0, 55px, 0);
		}

		.services-intro {
			min-height: auto;
			grid-template-columns: 1fr;
			gap: 2.5rem;
			padding-top: 7rem;
			padding-bottom: 5rem;
		}

		.services-label { padding-top: 0; }
		.services-key-mask {
			top: 12%;
			right: -28%;
			width: 138%;
			opacity: 0.055;
		}

		.heading-line { white-space: normal; }
		.services-heading h2 { font-size: clamp(3.25rem, 11vw, 6.5rem); }
		.services-scroll { padding-inline: var(--page-gutter); background: #dfe4e9; }
		.services-sticky { display: block; height: auto; min-height: 0; overflow: visible; padding-block: 1.25rem 5rem; background: transparent; }
		.services-track { display: grid; width: 100%; gap: 1rem; padding-inline: 0; }
		.service-card {
			width: 100%;
			height: auto;
			min-height: 0;
			grid-template-columns: 1fr;
		}

		.service-media { aspect-ratio: 4 / 3; }
		.service-body { min-height: 31rem; padding: clamp(1.5rem, 7vw, 2.5rem); }
		.service-body h3 { max-width: 10ch; font-size: clamp(2.7rem, 10vw, 4.6rem); }
		.service-bottom { grid-template-columns: 1fr; align-items: start; }
		.service-bottom a { justify-self: start; }
		.services-progress { display: none; }
		.specialized { grid-template-columns: 1fr; }
	}

	@media (max-width: 34rem) {
		.services-heading h2 { font-size: clamp(2.9rem, 13vw, 4.4rem); }
		.services-intro-copy { gap: 1.5rem; }
		.service-body { min-height: 29rem; }
		.service-body h3 { font-size: clamp(2.55rem, 12vw, 3.8rem); }
		.specialized { gap: 3rem; }
	}
</style>
