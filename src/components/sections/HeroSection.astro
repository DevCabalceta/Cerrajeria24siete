---
import { Image } from 'astro:assets';
import { HERO_SLIDES } from '../../data/hero-slides';
import { SITE } from '../../data/site';
---

<section class="hero" id="inicio" aria-labelledby="hero-title" data-hero data-section-panel>
	<div class="hero-media" data-hero-media data-section-transition-background>
		<div class="hero-slider" data-hero-slider>
			{HERO_SLIDES.map((slide, index) => (
				<div
					id={`hero-slide-${index + 1}`}
					class:list={['hero-slide', { 'is-active': index === 0 }]}
					data-hero-slide
					aria-hidden={index === 0 ? 'false' : 'true'}
					role="img"
					aria-label={slide.alt}
					style={`--slide-position-desktop: ${slide.desktopPosition}; --slide-position-mobile: ${slide.mobilePosition};`}
				>
					<Image
						src={slide.image}
						alt=""
						widths={[480, 720, 1080, 1440, 1920]}
						sizes="100vw"
						format="webp"
						quality={82}
						loading={index === 0 ? 'eager' : 'lazy'}
						fetchpriority={index === 0 ? 'high' : 'low'}
						decoding="async"
					/>
				</div>
			))}
		</div>
	</div>
	<div class="hero-shade" aria-hidden="true"></div>
	<div class="hero-grid" aria-hidden="true"></div>

	<div class="hero-content page-shell">
		<div class="hero-copy">
			<p class="hero-kicker" data-hero-eyebrow>
				<span aria-hidden="true"></span>
				Cerrajería profesional · Costa Rica
			</p>

			<h1 id="hero-title">
				<span class="title-line"><span data-hero-line>Cuando cada</span></span>{' '}
				<span class="title-line title-accent"><span data-hero-line>minuto cuenta,</span></span>{' '}
				<span class="title-line"><span data-hero-line>abrimos el camino.</span></span>
			</h1>

			<div class="hero-summary">
				<p data-hero-description>
					Atención a domicilio las 24 horas para hogares, vehículos y negocios.
					Respuesta profesional cuando más la necesita.
				</p>
				<div class="hero-actions" data-hero-actions>
					<a class="primary-action" href={SITE.whatsapp.href} target="_blank" rel="noreferrer">
						<span>{SITE.whatsapp.label}</span>
						<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5" /></svg>
					</a>
					<a class="secondary-action" href={SITE.phone.href}>
						<svg viewBox="0 0 24 24" aria-hidden="true">
							<path d="M8.4 3.5 6.7 2.9a2 2 0 0 0-2.4 1.2l-.8 2.1c-.4 1-.3 2.1.2 3.1 2.2 4.4 5.8 8 10.2 10.2 1 .5 2.1.6 3.1.2l2.1-.8a2 2 0 0 0 1.2-2.4l-.6-1.7a2 2 0 0 0-2.2-1.3l-2.2.4a1.9 1.9 0 0 1-1.7-.5l-3-3a1.9 1.9 0 0 1-.5-1.7l.4-2.2a2 2 0 0 0-1.3-2.2Z" />
						</svg>
						<span>Llamar ahora</span>
					</a>
				</div>
			</div>
		</div>

		<div class="hero-proof" data-hero-support aria-label="Datos destacados">
			<div><strong>+35</strong><span>años de experiencia</span></div>
			<div><strong>24/7</strong><span>atención de emergencias</span></div>
			<div><strong>CR</strong><span>servicio a domicilio</span></div>
		</div>
	</div>

	<a class="scroll-cue" href="#servicios" aria-label="Ver nuestros servicios" data-hero-support>
		<span>Explorar</span>
		<i aria-hidden="true"></i>
	</a>

	<nav class="hero-slider-controls" aria-label="Fondos del Hero">
		<button
			type="button"
			class="hero-slider-toggle"
			data-hero-slider-toggle
			aria-label="Pausar presentación"
			aria-pressed="false"
		>
			<svg class="icon-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14M16 5v14" /></svg>
			<svg class="icon-play" viewBox="0 0 24 24" aria-hidden="true"><path d="m8 5 11 7-11 7Z" /></svg>
		</button>
		{HERO_SLIDES.map((_, index) => (
			<button
				type="button"
				class:list={['hero-slide-control', { 'is-active': index === 0 }]}
				data-hero-slide-control={index}
				aria-label={`Mostrar fondo ${index + 1} de ${HERO_SLIDES.length}`}
				aria-controls={`hero-slide-${index + 1}`}
				aria-current={index === 0 ? 'true' : undefined}
			>
				<span class="hero-slide-track" aria-hidden="true">
					<span data-hero-slide-progress></span>
				</span>
			</button>
		))}
	</nav>
</section>

<style>
	:global(html[data-motion='pending']) :is([data-hero-eyebrow], [data-hero-description], [data-hero-actions], [data-hero-support]) {
		opacity: 0;
		transform: translate3d(0, 16px, 0);
	}

	:global(html[data-motion='pending']) [data-hero-line] {
		opacity: 0;
		transform: translate3d(0, 16px, 0);
	}

	.hero {
		position: relative;
		display: flex;
		min-height: max(44rem, 100svh);
		align-items: flex-end;
		isolation: isolate;
		overflow: hidden;
		background: var(--color-ink);
	}

	.hero-media, .hero-shade, .hero-grid { position: absolute; inset: 0; }
	.hero-media { z-index: -3; overflow: hidden; }
	.hero-media::after {
		position: absolute;
		inset: 0;
		z-index: 3;
		background: linear-gradient(180deg, rgba(7, 9, 13, 0.25), rgba(7, 9, 13, 0.06) 50%, rgba(7, 9, 13, 0.58));
		content: '';
		pointer-events: none;
	}

	.hero-slider, .hero-slide { position: absolute; inset: 0; }
	.hero-slider { background: var(--color-ink); }
	.hero-slide {
		opacity: 0;
		visibility: hidden;
		will-change: opacity;
	}

	.hero-slide.is-active { opacity: 1; visibility: visible; }
	.hero-slide :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: var(--slide-position-desktop);
	}

	.hero-shade {
		z-index: -2;
		background:
			linear-gradient(90deg, rgba(7, 9, 13, 0.94) 0%, rgba(7, 9, 13, 0.78) 37%, rgba(7, 9, 13, 0.42) 70%, rgba(7, 9, 13, 0.2)),
			linear-gradient(0deg, rgba(7, 9, 13, 0.88) 0%, transparent 48%);
	}

	.hero-grid {
		z-index: -1;
		background-image: linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px);
		background-size: clamp(4rem, 7vw, 7.5rem) clamp(4rem, 7vw, 7.5rem);
		mask-image: linear-gradient(90deg, black, transparent 72%);
	}

	.hero-content {
		display: grid;
		width: 100%;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: end;
		gap: clamp(2rem, 5vw, 6rem);
		padding-top: 9rem;
		padding-bottom: clamp(5rem, 8vh, 7rem);
	}

	.hero-copy { min-width: 0; max-width: 58rem; }
	.hero-kicker {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		margin: 0 0 clamp(1.35rem, 2.5vh, 2rem);
		color: rgba(247, 249, 252, 0.72);
		font-size: clamp(0.66rem, 0.8vw, 0.76rem);
		font-weight: 750;
		letter-spacing: 0.15em;
		text-transform: uppercase;
	}

	.hero-kicker span {
		width: 0.42rem;
		aspect-ratio: 1;
		border-radius: 50%;
		background: var(--color-signal);
		box-shadow: 0 0 1rem rgba(145, 255, 182, 0.75);
	}

	h1 {
		max-width: 14ch;
		margin: 0;
		font-size: clamp(3.4rem, 6.15vw, 6.8rem);
		font-weight: 520;
		letter-spacing: -0.064em;
		line-height: 0.94;
	}

	.title-line {
		display: block;
		padding: 0.05em 0.04em 0.09em 0;
	}

	.title-line > span { display: block; }
	.title-accent { color: var(--color-electric-light); }

	.hero-summary {
		display: grid;
		max-width: 46rem;
		gap: clamp(1.4rem, 2.8vh, 2rem);
		margin-top: clamp(1.75rem, 3.5vh, 2.75rem);
	}

	.hero-summary > p {
		max-width: 40rem;
		margin: 0;
		color: rgba(247, 249, 252, 0.74);
		font-size: clamp(0.96rem, 1.12vw, 1.08rem);
		line-height: 1.68;
	}

	.hero-actions {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.85rem;
	}

	.primary-action {
		display: inline-flex;
		min-height: 3.65rem;
		align-items: center;
		gap: 1.5rem;
		border-radius: 999px;
		background: #f7f9fc;
		padding: 0.8rem 0.85rem 0.8rem 1.4rem;
		color: var(--color-ink);
		font-size: 0.8rem;
		font-weight: 800;
		text-decoration: none;
		transition: transform 220ms ease, background 220ms ease;
	}

	.primary-action svg {
		width: 2.05rem;
		aspect-ratio: 1;
		border-radius: 50%;
		background: var(--color-electric);
		fill: none;
		padding: 0.48rem;
		stroke: white;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.6;
		transition: transform 220ms ease;
	}

	.primary-action:hover { transform: translateY(-2px); background: var(--color-electric-light); }
	.primary-action:hover svg { transform: translateX(2px); }
	.secondary-action {
		display: inline-flex;
		min-height: 3.65rem;
		align-items: center;
		justify-content: center;
		gap: 0.7rem;
		border: 1px solid rgba(255, 255, 255, 0.2);
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.065);
		padding: 0.8rem 1.35rem;
		color: rgba(247, 249, 252, 0.88);
		font-size: 0.8rem;
		font-weight: 760;
		text-decoration: none;
		transition: transform 220ms ease, border-color 220ms ease, background 220ms ease, color 220ms ease;
	}

	.secondary-action svg {
		width: 1.05rem;
		fill: none;
		stroke: var(--color-electric-light);
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.65;
	}

	.secondary-action:hover {
		transform: translateY(-2px);
		border-color: rgba(138, 215, 255, 0.56);
		background: rgba(32, 164, 255, 0.13);
		color: white;
	}

	.hero-proof { display: grid; width: 10rem; gap: 1.25rem; padding-bottom: 0.3rem; }
	.hero-proof > div {
		display: grid;
		gap: 0.18rem;
		border-top: 1px solid rgba(255, 255, 255, 0.18);
		padding-top: 0.85rem;
	}

	.hero-proof strong { font-size: 1.55rem; font-weight: 520; letter-spacing: -0.045em; }
	.hero-proof span { color: rgba(247, 249, 252, 0.48); font-size: 0.64rem; line-height: 1.45; }

	.scroll-cue {
		position: absolute;
		right: var(--page-gutter);
		bottom: 1.4rem;
		display: flex;
		align-items: center;
		gap: 0.75rem;
		color: rgba(247, 249, 252, 0.45);
		font-size: 0.61rem;
		font-weight: 750;
		letter-spacing: 0.13em;
		text-decoration: none;
		text-transform: uppercase;
	}

	.scroll-cue i { position: relative; display: block; width: 2.5rem; height: 1px; overflow: hidden; background: rgba(255, 255, 255, 0.18); }
	.scroll-cue i::after {
		position: absolute;
		inset: 0;
		transform: translateX(-100%);
		background: var(--color-electric-light);
		content: '';
		animation: scroll-line 2.2s ease-in-out infinite;
	}

	.hero-slider-controls {
		position: absolute;
		z-index: 2;
		bottom: 1.1rem;
		left: 50%;
		display: flex;
		align-items: center;
		gap: 0.25rem;
		transform: translateX(-50%);
	}

	.hero-slider-toggle,
	.hero-slide-control {
		display: grid;
		height: 2rem;
		place-items: center;
		border: 0;
		background: transparent;
		padding: 0;
		color: rgba(247, 249, 252, 0.88);
		cursor: pointer;
	}

	.hero-slider-toggle { width: 2rem; margin-right: 0.2rem; }
	.hero-slider-toggle svg {
		width: 0.9rem;
		height: 0.9rem;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 3;
	}

	.hero-slider-toggle .icon-play { display: none; }
	.hero-slider-toggle.is-paused .icon-pause { display: none; }
	.hero-slider-toggle.is-paused .icon-play { display: block; }
	.hero-slider-toggle:hover { color: #fff; }
	.hero-slide-control { width: 1.65rem; transition: width 280ms ease; }
	.hero-slide-control.is-active { width: 4.1rem; }
	.hero-slide-track {
		position: relative;
		display: block;
		width: 0.5rem;
		height: 0.5rem;
		overflow: hidden;
		border-radius: 999px;
		background: rgba(247, 249, 252, 0.38);
		transition: width 280ms ease, height 280ms ease, background 220ms ease;
	}

	.hero-slide-control.is-active .hero-slide-track {
		width: 3.65rem;
		height: 0.42rem;
		background: rgba(247, 249, 252, 0.3);
	}

	.hero-slide-track > span {
		position: absolute;
		inset: 0;
		transform: scaleX(0);
		transform-origin: left center;
		border-radius: inherit;
		background: var(--color-electric-light);
		box-shadow: 0 0 0.65rem rgba(138, 215, 255, 0.48);
		opacity: 0;
		transition: opacity 180ms ease;
	}

	.hero-slide-control.is-active .hero-slide-track > span { opacity: 1; }
	.hero-slide-control:hover .hero-slide-track { background: rgba(247, 249, 252, 0.48); }
	.hero-slider-toggle:focus-visible,
	.hero-slide-control:focus-visible {
		outline: 2px solid var(--color-electric-light);
		outline-offset: -0.2rem;
	}

	@keyframes scroll-line {
		0% { transform: translateX(-100%); }
		55%, 100% { transform: translateX(100%); }
	}

	@media (max-width: 68rem) {
		.hero-content { grid-template-columns: 1fr; }
		.hero-proof { width: min(100%, 34rem); grid-template-columns: repeat(3, minmax(0, 1fr)); }
	}

	@media (max-width: 48rem) {
		:global(html[data-motion='pending']) :is([data-hero-eyebrow], [data-hero-line], [data-hero-description], [data-hero-actions], [data-hero-support]) {
			transform: none;
		}

		.hero { min-height: max(46rem, 100svh); }
		.hero-slide :global(img) { object-position: var(--slide-position-mobile); }
		.hero-shade {
			background:
				linear-gradient(0deg, rgba(7, 9, 13, 0.98) 0%, rgba(7, 9, 13, 0.91) 35%, rgba(7, 9, 13, 0.48) 72%, rgba(7, 9, 13, 0.22) 100%),
				linear-gradient(90deg, rgba(7, 9, 13, 0.32), transparent 70%);
		}
		.hero-grid { opacity: 0.55; mask-image: linear-gradient(0deg, black, transparent 80%); }
		.hero-content { align-content: end; gap: 2rem; padding-top: 8rem; padding-bottom: 3.8rem; }
		h1 { max-width: 14ch; font-size: clamp(2.65rem, 7.1vw, 4.5rem); line-height: 0.96; }
		.hero-summary { gap: 1.3rem; margin-top: 1.5rem; }
		.hero-actions { width: min(100%, 27rem); flex-wrap: nowrap; gap: 0.65rem; }
		.primary-action, .secondary-action { min-width: 0; justify-content: center; }
		.primary-action { flex: 1.08 1 0; gap: 0.8rem; padding-inline: 1rem 0.7rem; }
		.secondary-action { flex: 0.92 1 0; padding-inline: 1rem; }
		.hero-proof { gap: 0.75rem; }
		.hero-proof strong { font-size: 1.25rem; }
		.scroll-cue { display: none; }
	}

	@media (max-width: 30rem) {
		.hero { min-height: max(41rem, 100svh); }
		.hero-content { gap: 1.35rem; padding-top: 6.75rem; padding-bottom: 2.5rem; }
		.hero-kicker { margin-bottom: 1.05rem; letter-spacing: 0.1em; }
		.hero-summary { gap: 1rem; margin-top: 1.15rem; }
		.hero-summary > p { font-size: 0.88rem; line-height: 1.6; }
		.hero-actions { display: flex; width: 100%; gap: 0.5rem; }
		.primary-action, .secondary-action { width: auto; min-height: 3.4rem; font-size: 0.68rem; }
		.primary-action { flex: 1.1 1 0; gap: 0.45rem; padding: 0.55rem 0.45rem; }
		.primary-action svg { width: 1.8rem; padding: 0.4rem; }
		.secondary-action { flex: 0.9 1 0; gap: 0.35rem; padding: 0.55rem 0.4rem; }
		.secondary-action svg { width: 0.9rem; }
		.hero-proof span { font-size: 0.58rem; }
		.hero-slider-controls { bottom: 0.15rem; }
		.hero-slider-toggle { width: 1.85rem; height: 2.15rem; }
		.hero-slide-control { height: 2.15rem; }
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-slide { will-change: auto; }
		.hero-slider-toggle { display: none; }
		.hero-slide-control,
		.hero-slide-track { transition: none; }
		.scroll-cue i::after { animation: none; }
	}
</style>
